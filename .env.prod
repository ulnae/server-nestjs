// 环境
NODE_ENV=production

// 端口
PORT=3000

// 数据库地址
DB_HOST=localhost
// 数据库端口
DB_PORT=3306
// 数据库登录名
DB_USER=root
// 数据库登录密码
DB_PASSWD=root
// 数据库名字
DB_DATABASE=database_nest

// jwt密钥
JWT_SECRET=server-nestjs-jwt-secret
// jwt过期时间
JWT_EXPIRES_IN=168h

// 接口前缀
PREFIX=/api

// session配置
SESSION_NAME=nestjs.sid
SESSION_SECRET=your-secret-key

// 允许跨域的前端来源（逗号分隔）。留空 = 不放行任何跨域请求
ALLOW_ORIGIN=https://ulnae.github.io

// 系统广播 POST /alert 的共享密钥。留空 = 该接口关闭（默认拒绝）
ALERT_SECRET=