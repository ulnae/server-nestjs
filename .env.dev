// 环境
NODE_ENV=dev

// 端口
PORT=3000

// 数据库地址
DB_HOST=localhost
// 数据库端口
DB_PORT=3306
// 数据库登录名
DB_USER=root
// 数据库登录密码
DB_PASSWD=root
// 数据库名字
DB_DATABASE=database_nest

// jwt密钥
JWT_SECRET=server-nestjs-jwt-secret
// jwt过期时间
JWT_EXPIRES_IN=24h

// 接口前缀
PREFIX=/api

// session配置
SESSION_NAME=nestjs.sid
SESSION_SECRET=your-secret-key

// 允许跨域的前端来源（逗号分隔）。留空 = 不放行任何跨域请求
// vite dev 默认跑在 8090（见 Discuss/vite.config.ts），本机与局域网各写一条
ALLOW_ORIGIN=http://localhost:8090,http://127.0.0.1:8090,http://192.168.58.190:8090,http://localhost,http://192.168.58.190

// 系统广播 POST /alert 的共享密钥。留空 = 该接口关闭（默认拒绝）
ALERT_SECRET=

// Cloudflare Realtime TURN（GET /rtc/ice 下发短期凭证给前端通话用）。
// Dashboard → Calls → Create TURN key 后填入；都留空 = 降级为 Cloudflare 免费 STUN（跨网络通话将连不上）
TURN_KEY_ID=
TURN_KEY_API_TOKEN=
